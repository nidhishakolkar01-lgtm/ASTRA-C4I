{
  "name": "c-uas-threat-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "ASTRA-CUAS: AI-Enabled Drone & Counter-Drone Threat Simulation Trainer (MoD DSSC)",
  "main": "server.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postinstall": "npm run build",
    "start": "node server.cjs",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "vite --port 5173 & electron electron/main.cjs",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "canvas-confetti": "^1.9.2",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  },
  "overrides": {
    "tar": "^7.5.22",
    "braces": "^3.0.3",
    "http-cache-semantics": "^4.3.0"
  },
  "build": {
    "appId": "in.gov.sih.astra.cuas",
    "productName": "ASTRA-CUAS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ASTRA C-UAS Simulator"
    }
  }
}
